# Python cache
__pycache__/
*.py[cod]
*$py.class

# Python build artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data
# Data artifacts
data/*
!data/processed/
data/processed/*
!data/processed/.gitignore
!data/processed/*.dvc
!data/processed/cicids2017/
data/processed/cicids2017/*
!data/processed/cicids2017/.gitignore
!data/processed/cicids2017/*.dvc
data/raw/
data/interim/

data/external/*
!data/external/
!data/external/*.dvc
!data/external/lanl.dvc

# Large local LANL payloads
/data/external/lanl/**
/data/processed/lanl/**

# Keep DVC pointer files trackable
!data/processed/lanl.dvc
*.csv
# Test fixtures
!tests/
!tests/fixtures/
!tests/fixtures/cicids2017/
!tests/fixtures/cicids2017/*.csv
*.parquet
*.jsonl
*.pkl


# Model and experiment artifacts
artifacts/
mlruns/
checkpoints/
*.pt
*.pth
*.onnx
*.joblib
mlflow/
mlflow/
mlflow.db
mlruns/

# Logs
logs/
*.log

# Environment and secrets
.env
.env.*
*.pem
*.key
*.crt

# Jupyter
.ipynb_checkpoints/

# OS/editor files
.DS_Store
.idea/
.vscode/

# Terraform
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/.terraform.lock.hcl

# Docker/local runtime
*.pid
*.sock

# Temporary files
tmp/
temp/
*.tmp
misc/
